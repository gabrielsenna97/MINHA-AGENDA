<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Minha Agenda - UTE Maués</title>

<style>

:root{
    --bg:#050914;
    --bg2:#08111f;
    --panel:rgba(13,25,43,.78);
    --panel2:rgba(18,34,57,.88);
    --line:rgba(120,190,255,.14);

    --blue:#28a9ff;
    --cyan:#00e5ff;
    --green:#23e6a3;
    --yellow:#ffd166;
    --orange:#ff9f43;
    --red:#ff5577;
    --purple:#9b7cff;

    --text:#edf7ff;
    --muted:#8da4ba;

    --shadow:
        0 20px 50px rgba(0,0,0,.45),
        inset 0 1px 0 rgba(255,255,255,.04);

    --radius:20px;
}

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Inter,Segoe UI,Arial,sans-serif;
    color:var(--text);
    background:
        radial-gradient(circle at 15% 10%,rgba(0,229,255,.08),transparent 30%),
        radial-gradient(circle at 85% 20%,rgba(40,169,255,.08),transparent 30%),
        linear-gradient(135deg,#030711,#071321 50%,#030711);
    min-height:100vh;
    overflow-x:hidden;
}

/* FUNDO 3D */

body::before{
    content:"";
    position:fixed;
    inset:0;
    pointer-events:none;
    opacity:.12;
    background-image:
        linear-gradient(rgba(40,169,255,.16) 1px,transparent 1px),
        linear-gradient(90deg,rgba(40,169,255,.16) 1px,transparent 1px);
    background-size:45px 45px;
    transform:perspective(700px) rotateX(60deg) scale(1.7);
    transform-origin:center bottom;
}

/* APP */

.app{
    display:flex;
    min-height:100vh;
}

/* SIDEBAR */

.sidebar{
    position:fixed;
    z-index:20;
    width:270px;
    height:100vh;
    padding:20px 16px;

    background:rgba(4,12,24,.86);
    backdrop-filter:blur(25px);

    border-right:1px solid var(--line);

    box-shadow:
        10px 0 50px rgba(0,0,0,.35),
        inset -1px 0 rgba(255,255,255,.03);

    overflow-y:auto;
}

.logo{
    display:flex;
    align-items:center;
    gap:12px;
    padding:8px 8px 22px;
}

.logo-icon{
    width:48px;
    height:48px;
    border-radius:15px;

    display:flex;
    align-items:center;
    justify-content:center;

    font-size:24px;

    background:
        linear-gradient(145deg,#0d3555,#061321);

    border:1px solid rgba(0,229,255,.35);

    box-shadow:
        0 0 25px rgba(0,229,255,.15),
        inset 0 2px 5px rgba(255,255,255,.08);
}

.logo strong{
    display:block;
    font-size:16px;
}

.logo span{
    display:block;
    color:var(--cyan);
    font-size:11px;
    margin-top:3px;
}

.menu-title{
    font-size:10px;
    letter-spacing:2px;
    color:#607b94;
    margin:22px 10px 8px;
}

.menu-btn{
    width:100%;
    border:0;
    color:#8ea8bf;
    background:transparent;

    display:flex;
    align-items:center;
    gap:12px;

    padding:13px 14px;
    margin:4px 0;

    border-radius:14px;
    cursor:pointer;

    text-align:left;
    font-size:14px;

    transition:.2s;
}

.menu-btn:hover{
    color:white;
    background:rgba(40,169,255,.08);
    transform:translateX(3px);
}

.menu-btn.active{
    color:white;

    background:
        linear-gradient(135deg,
        rgba(40,169,255,.18),
        rgba(0,229,255,.05));

    border:1px solid rgba(40,169,255,.22);

    box-shadow:
        0 8px 25px rgba(0,0,0,.2),
        inset 0 1px rgba(255,255,255,.04);
}

.menu-icon{
    width:28px;
    height:28px;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:9px;

    background:rgba(255,255,255,.04);
}

/* MAIN */

.main{
    width:calc(100% - 270px);
    margin-left:270px;
    padding:25px;
}

/* TOPBAR */

.topbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:15px;

    margin-bottom:25px;
}

.page-title h1{
    font-size:27px;
    letter-spacing:-.5px;
}

.page-title p{
    color:var(--muted);
    font-size:13px;
    margin-top:5px;
}

.top-actions{
    display:flex;
    align-items:center;
    gap:10px;
}

.date-box{
    padding:11px 16px;
    border:1px solid var(--line);
    border-radius:14px;

    background:rgba(255,255,255,.03);

    color:#9cb5ca;
    font-size:12px;
}

/* BOTÕES */

.btn{
    border:1px solid rgba(255,255,255,.08);

    padding:11px 16px;
    border-radius:13px;

    color:white;

    background:
        linear-gradient(145deg,#143553,#0b1d30);

    cursor:pointer;

    box-shadow:
        0 7px 0 #06101c,
        0 12px 25px rgba(0,0,0,.25),
        inset 0 1px rgba(255,255,255,.08);

    transition:.15s;

    font-weight:600;
}

.btn:hover{
    transform:translateY(-2px);
    box-shadow:
        0 9px 0 #06101c,
        0 15px 30px rgba(0,0,0,.3),
        0 0 20px rgba(40,169,255,.12);
}

.btn:active{
    transform:translateY(4px);
    box-shadow:0 3px 0 #06101c;
}

.btn-primary{
    background:
        linear-gradient(145deg,#158bd3,#07558b);
}

.btn-success{
    background:
        linear-gradient(145deg,#159f76,#08654d);
}

.btn-danger{
    background:
        linear-gradient(145deg,#a52f50,#691d32);
}

.btn-small{
    padding:7px 10px;
    font-size:11px;
}

/* CARDS */

.cards{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:15px;
    margin-bottom:20px;
}

.card{
    position:relative;
    overflow:hidden;

    padding:20px;

    border-radius:var(--radius);

    background:
        linear-gradient(145deg,
        rgba(19,38,62,.85),
        rgba(7,18,32,.9));

    border:1px solid var(--line);

    box-shadow:var(--shadow);

    transform-style:preserve-3d;

    transition:.25s;
}

.card:hover{
    transform:
        perspective(700px)
        rotateX(2deg)
        rotateY(-2deg)
        translateY(-4px);

    border-color:rgba(40,169,255,.3);
}

.card::after{
    content:"";
    position:absolute;
    width:100px;
    height:100px;
    right:-45px;
    top:-45px;

    background:rgba(0,229,255,.08);
    border-radius:50%;
    filter:blur(5px);
}

.card-icon{
    font-size:22px;
    margin-bottom:13px;
}

.card-number{
    font-size:30px;
    font-weight:800;
}

.card-label{
    color:var(--muted);
    font-size:12px;
    margin-top:5px;
}

/* GRID */

.grid{
    display:grid;
    grid-template-columns:1.35fr 1fr;
    gap:18px;
}

.panel{
    background:
        linear-gradient(145deg,
        rgba(14,29,48,.82),
        rgba(6,16,29,.9));

    border:1px solid var(--line);
    border-radius:var(--radius);

    box-shadow:var(--shadow);

    padding:20px;

    margin-bottom:18px;
}

.panel-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:10px;

    margin-bottom:18px;
}

.panel-title{
    font-size:15px;
    font-weight:700;
}

.panel-sub{
    color:#6f889e;
    font-size:11px;
    margin-top:3px;
}

/* QUICK ACTIONS */

.quick{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
}

.quick-btn{
    min-height:105px;

    padding:15px;

    border-radius:17px;

    border:1px solid rgba(255,255,255,.07);

    background:
        linear-gradient(145deg,
        rgba(21,48,76,.9),
        rgba(7,19,33,.95));

    color:white;

    cursor:pointer;

    box-shadow:
        0 8px 0 #040c15,
        0 15px 30px rgba(0,0,0,.3),
        inset 0 1px rgba(255,255,255,.06);

    transition:.18s;

    text-align:left;
}

.quick-btn:hover{
    transform:translateY(-5px) scale(1.015);

    border-color:rgba(0,229,255,.3);

    box-shadow:
        0 12px 0 #040c15,
        0 20px 35px rgba(0,0,0,.35),
        0 0 25px rgba(0,229,255,.08);
}

.quick-icon{
    font-size:25px;
    margin-bottom:15px;
}

.quick-title{
    font-size:13px;
    font-weight:700;
}

.quick-sub{
    font-size:10px;
    color:#718ba2;
    margin-top:4px;
}

/* LISTA */

.item{
    display:flex;
    justify-content:space-between;
    gap:12px;

    padding:14px;

    margin-bottom:9px;

    border:1px solid rgba(255,255,255,.06);
    border-radius:14px;

    background:rgba(255,255,255,.025);
}

.item-main{
    min-width:0;
}

.item-title{
    font-size:13px;
    font-weight:700;
}

.item-info{
    color:#7e98ae;
    font-size:11px;
    margin-top:5px;
}

.item-actions{
    display:flex;
    gap:5px;
    align-items:center;
}

/* BADGES */

.badge{
    display:inline-flex;
    padding:4px 8px;
    border-radius:20px;

    font-size:10px;
    font-weight:700;

    margin-left:5px;
}

.badge-green{
    color:#53edbd;
    background:rgba(35,230,163,.1);
}

.badge-yellow{
    color:#ffd166;
    background:rgba(255,209,102,.1);
}

.badge-red{
    color:#ff6685;
    background:rgba(255,85,119,.1);
}

.badge-blue{
    color:#52c5ff;
    background:rgba(40,169,255,.1);
}

.badge-purple{
    color:#b19cff;
    background:rgba(155,124,255,.1);
}

/* FORM */

.form-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:13px;
}

.form-group{
    margin-bottom:13px;
}

.form-group.full{
    grid-column:1/-1;
}

label{
    display:block;
    color:#8fa7bb;
    font-size:11px;
    margin-bottom:6px;
}

input,
select,
textarea{
    width:100%;

    border:1px solid rgba(120,190,255,.12);

    border-radius:12px;

    background:#071321;
    color:white;

    padding:12px;

    outline:none;

    font-family:inherit;
}

input:focus,
select:focus,
textarea:focus{
    border-color:rgba(0,229,255,.4);

    box-shadow:
        0 0 0 3px rgba(0,229,255,.05),
        0 0 20px rgba(0,229,255,.05);
}

textarea{
    resize:vertical;
    min-height:100px;
}

.form-buttons{
    display:flex;
    justify-content:flex-end;
    gap:8px;
    margin-top:5px;
}

/* FILTROS */

.filters{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
    margin-bottom:15px;
}

.filter{
    padding:8px 12px;
    border-radius:20px;

    border:1px solid var(--line);
    background:rgba(255,255,255,.03);

    color:#88a0b5;

    cursor:pointer;
    font-size:11px;
}

.filter.active{
    color:white;
    border-color:rgba(0,229,255,.3);
    background:rgba(0,229,255,.08);
}

/* MOVIMENTAÇÃO */

.mov-card{
    padding:16px;

    border-radius:16px;

    background:
        linear-gradient(145deg,
        rgba(18,40,62,.7),
        rgba(6,17,29,.85));

    border:1px solid rgba(255,255,255,.06);

    margin-bottom:10px;
}

.mov-route{
    display:flex;
    align-items:center;
    gap:10px;

    font-size:15px;
    font-weight:800;
}

.arrow{
    color:var(--cyan);
}

.mov-piece{
    color:#9cb5ca;
    font-size:12px;
    margin-top:8px;
}

.mov-meta{
    color:#627d94;
    font-size:10px;
    margin-top:8px;
}

/* SEMANA */

.week-grid{
    display:grid;
    grid-template-columns:repeat(6,1fr);
    gap:10px;
}

.day{
    min-height:230px;

    border-radius:16px;

    border:1px solid rgba(255,255,255,.06);

    background:rgba(255,255,255,.025);

    padding:12px;
}

.day-header{
    text-align:center;
    color:var(--cyan);
    font-size:12px;
    font-weight:800;

    padding-bottom:10px;
    border-bottom:1px solid rgba(255,255,255,.05);

    margin-bottom:10px;
}

.day-item{
    background:rgba(40,169,255,.06);

    border-left:3px solid var(--blue);

    padding:9px;

    border-radius:8px;

    margin-bottom:7px;

    font-size:10px;
}

.day-item strong{
    display:block;
    margin-bottom:3px;
}

/* NOTAS */

.note-area{
    min-height:450px;
}

/* PESQUISA */

.search-box{
    position:relative;
    margin-bottom:18px;
}

.search-box input{
    padding-left:42px;
}

.search-icon{
    position:absolute;
    left:15px;
    top:12px;
    font-size:17px;
}

/* MODAL */

.modal{
    position:fixed;
    z-index:100;

    inset:0;

    display:none;
    align-items:center;
    justify-content:center;

    padding:20px;

    background:rgba(0,0,0,.7);

    backdrop-filter:blur(10px);
}

.modal.show{
    display:flex;
}

.modal-content{
    width:100%;
    max-width:650px;
    max-height:90vh;
    overflow:auto;

    padding:25px;

    border-radius:23px;

    background:
        linear-gradient(145deg,
        #10243a,
        #071321);

    border:1px solid rgba(0,229,255,.18);

    box-shadow:
        0 30px 100px rgba(0,0,0,.7),
        0 0 50px rgba(0,229,255,.05);
}

.modal-header{
    display:flex;
    justify-content:space-between;
    align-items:center;

    margin-bottom:20px;
}

.modal-title{
    font-size:19px;
}

.close{
    border:0;
    background:rgba(255,255,255,.05);
    color:white;

    width:35px;
    height:35px;

    border-radius:10px;

    cursor:pointer;
}

/* EMPTY */

.empty{
    padding:35px;
    text-align:center;
    color:#617a91;
    font-size:12px;
}

/* MOBILE */

.mobile-menu{
    display:none;
}

@media(max-width:1200px){

    .cards{
        grid-template-columns:repeat(3,1fr);
    }

    .quick{
        grid-template-columns:repeat(2,1fr);
    }

    .week-grid{
        grid-template-columns:repeat(3,1fr);
    }
}

@media(max-width:850px){

    .sidebar{
        transform:translateX(-100%);
        transition:.25s;
    }

    .sidebar.open{
        transform:translateX(0);
    }

    .main{
        width:100%;
        margin-left:0;
        padding:15px;
    }

    .mobile-menu{
        display:flex;

        width:42px;
        height:42px;

        align-items:center;
        justify-content:center;

        border-radius:12px;

        background:#10243a;
        border:1px solid var(--line);

        color:white;

        cursor:pointer;
    }

    .topbar{
        align-items:flex-start;
    }

    .date-box{
        display:none;
    }

    .grid{
        grid-template-columns:1fr;
    }

    .cards{
        grid-template-columns:repeat(2,1fr);
    }

    .week-grid{
        grid-template-columns:repeat(2,1fr);
    }
}

@media(max-width:550px){

    .cards{
        grid-template-columns:1fr 1fr;
        gap:9px;
    }

    .card{
        padding:14px;
    }

    .card-number{
        font-size:23px;
    }

    .quick{
        grid-template-columns:1fr 1fr;
    }

    .form-grid{
        grid-template-columns:1fr;
    }

    .form-group.full{
        grid-column:auto;
    }

    .week-grid{
        grid-template-columns:1fr;
    }

    .top-actions .btn{
        display:none;
    }

    .page-title h1{
        font-size:22px;
    }
}

</style>
</head>

<body>

<div class="app">

<!-- SIDEBAR -->

<aside class="sidebar" id="sidebar">

    <div class="logo">

        <div class="logo-icon">
            ⚡
        </div>

        <div>
            <strong>MINHA AGENDA</strong>
            <span>UTE MAUÉS • CONTROL</span>
        </div>

    </div>

    <div class="menu-title">PRINCIPAL</div>

    <button class="menu-btn active" onclick="abrirPagina('inicio')">
        <span class="menu-icon">⌂</span>
        Início
    </button>

    <button class="menu-btn" onclick="abrirPagina('agenda')">
        <span class="menu-icon">📅</span>
        Agenda
    </button>


    <div class="menu-title">ORGANIZAÇÃO</div>

    <button class="menu-btn" onclick="abrirPagina('tarefas')">
        <span class="menu-icon">✓</span>
        Tarefas
    </button>

    <button class="menu-btn" onclick="abrirPagina('programacao')">
        <span class="menu-icon">▦</span>
        Programação Semanal
    </button>

    <button class="menu-btn" onclick="abrirPagina('lembretes')">
        <span class="menu-icon">🔔</span>
        Lembretes
    </button>


    <div class="menu-title">REGISTROS</div>

    <button class="menu-btn" onclick="abrirPagina('servicos')">
        <span class="menu-icon">🛠️</span>
        Serviços Realizados
    </button>

    <button class="menu-btn" onclick="abrirPagina('movimentacoes')">
        <span class="menu-icon">🔧</span>
        Movimentações
    </button>

    <button class="menu-btn" onclick="abrirPagina('bloco')">
        <span class="menu-icon">🗒️</span>
        Bloco de Notas
    </button>


    <div class="menu-title">SISTEMA</div>

    <button class="menu-btn" onclick="abrirPagina('pesquisa')">
        <span class="menu-icon">🔎</span>
        Pesquisa Geral
    </button>

</aside>


<!-- MAIN -->

<main class="main">

    <div class="topbar">

        <div style="display:flex;gap:12px;align-items:center">

            <button class="mobile-menu" onclick="toggleMenu()">
                ☰
            </button>

            <div class="page-title">

                <h1 id="pageTitle">
                    Painel de Controle
                </h1>

                <p id="pageSubtitle">
                    Organização pessoal da rotina da UTE
                </p>

            </div>

        </div>

        <div class="top-actions">

            <div class="date-box" id="dataAtual"></div>

            <button class="btn btn-primary"
                    onclick="abrirModal('tarefa')">
                + Nova Tarefa
            </button>

        </div>

    </div>


    <div id="conteudo"></div>

</main>

</div>


<!-- MODAL -->

<div class="modal" id="modal">

    <div class="modal-content">

        <div class="modal-header">

            <div class="modal-title" id="modalTitulo">
                Novo Registro
            </div>

            <button class="close"
                    onclick="fecharModal()">
                ✕
            </button>

        </div>

        <div id="modalBody"></div>

    </div>

</div>


<script>

/* =========================================================
   BANCO LOCAL
========================================================= */

let dados = JSON.parse(
    localStorage.getItem("minha_agenda_ute")
) || {

    tarefas:[],
    movimentacoes:[],
    servicos:[],
    agenda:[],
    lembretes:[],
    programacao:[],
    bloco:""

};


/* =========================================================
   SALVAR
========================================================= */

function salvar(){

    localStorage.setItem(
        "minha_agenda_ute",
        JSON.stringify(dados)
    );

}


/* =========================================================
   UTILIDADES
========================================================= */

function hoje(){

    const d = new Date();

    return d.toISOString().split("T")[0];

}


function horaAtual(){

    return new Date().toLocaleTimeString(
        "pt-BR",
        {
            hour:"2-digit",
            minute:"2-digit"
        }
    );

}


function formatarData(data){

    if(!data) return "";

    const partes = data.split("-");

    return `${partes[2]}/${partes[1]}/${partes[0]}`;

}


function escapar(texto){

    if(texto === undefined || texto === null)
        return "";

    return String(texto)
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


function id(){

    return Date.now() + Math.floor(Math.random()*999);

}


/* =========================================================
   DATA TOPO
========================================================= */

function atualizarData(){

    const agora = new Date();

    document.getElementById("dataAtual").innerText =
        agora.toLocaleDateString(
            "pt-BR",
            {
                weekday:"long",
                day:"2-digit",
                month:"long"
            }
        );

}


/* =========================================================
   NAVEGAÇÃO
========================================================= */

const titulos = {

    inicio:[
        "Painel de Controle",
        "Visão geral da sua rotina"
    ],

    agenda:[
        "Agenda",
        "Compromissos e compromissos operacionais"
    ],

    tarefas:[
        "Tarefas",
        "Controle das atividades"
    ],

    servicos:[
        "Serviços Realizados",
        "Histórico dos serviços executados"
    ],

    movimentacoes:[
        "Movimentações",
        "Controle simples de peças e componentes"
    ],

    programacao:[
        "Programação Semanal",
        "Organização das atividades por dia"
    ],

    lembretes:[
        "Lembretes",
