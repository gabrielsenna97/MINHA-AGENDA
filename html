========================================================= */

function salvarTarefa(event,editarId){

    event.preventDefault();

    const registro = {

        id: editarId || id(),

        titulo:
            document.getElementById("tarefaTitulo").value,

        data:
            document.getElementById("tarefaData").value,

        hora:
            document.getElementById("tarefaHora").value,

        prioridade:
            document.getElementById("tarefaPrioridade").value,

        observacao:
            document.getElementById("tarefaObs").value,

        status:
            document.getElementById("tarefaStatus").value

    };


    if(editarId){

        const i =
            dados.tarefas.findIndex(
                x=>x.id===editarId
            );

        dados.tarefas[i] = registro;

    }else{

        dados.tarefas.push(registro);

    }


    salvar();
    fecharModal();
    renderTarefas();

}


