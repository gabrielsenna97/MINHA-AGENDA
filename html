            .forEach(x=>x.classList.remove("active"));

        botao.classList.add("active");

    }


    let lista =
        dados.tarefas.slice()
        .sort((a,b)=>
            (a.data+a.hora)
            .localeCompare(b.data+b.hora)
        );


    if(filtro==="HOJE")
        lista =
            lista.filter(x=>x.data===hoje());


    if(filtro==="PENDENTES")
        lista =
            lista.filter(x=>x.status!=="CONCLUIDA");


    if(filtro==="CONCLUIDAS")
        lista =
            lista.filter(x=>x.status==="CONCLUIDA");


    const area =
        document.getElementById("listaTarefas");


    if(!lista.length){

        area.innerHTML =
            `<div class="empty">Nenhuma tarefa encontrada.</div>`;

        return;

    }


    area.innerHTML =
        lista.map(x=>`

        <div class="item">

            <div class="item-main">

                <div class="item-title">

                    ${escapar(x.titulo)}

                    <span class="badge ${
                        x.status==="CONCLUIDA"
                        ? "badge-green"
                        : x.prioridade==="URGENTE"
                        ? "badge-red"
                        : x.prioridade==="ALTA"
                        ? "badge-yellow"
                        : "badge-blue"
                    }">

                        ${x.status==="CONCLUIDA"
                            ? "CONCLUÍDA"
                            : x.prioridade}

                    </span>

                </div>

                <div class="item-info">

                    ${formatarData(x.data)}

                    ${x.hora ? " • "+x.hora : ""}

                    ${x.observacao
                        ? " • "+escapar(x.observacao)
                        : ""}

                </div>

            </div>


            <div class="item-actions">

                ${
                    x.status!=="CONCLUIDA"
