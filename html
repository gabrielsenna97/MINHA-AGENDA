function executarPesquisa(){

    const termo =
        document
        .getElementById("pesquisaGeral")
        .value
        .toLowerCase()
        .trim();


    const area =
        document.getElementById("resultadoPesquisa");


    if(!termo){

        area.innerHTML=
            `<div class="empty">
                Digite algo para pesquisar.
            </div>`;

        return;

    }


    let resultados=[];


    dados.tarefas.forEach(x=>{

        const texto =
            `${x.titulo} ${x.observacao} ${x.data} ${x.hora}`;

        if(texto.toLowerCase().includes(termo)){

            resultados.push({

                tipo:"📋 Tarefa",
                titulo:x.titulo,
                info:`${formatarData(x.data)} ${x.hora||""}`

            });

        }

    });


    dados.servicos.forEach(x=>{

        const texto =
            `${x.ugd} ${x.servico} ${x.os} ${x.observacao}`;

        if(texto.toLowerCase().includes(termo)){

            resultados.push({

                tipo:"🛠️ Serviço",
                titulo:`UGD ${x.ugd} • ${x.servico}`,
                info:`OS ${x.os||"-"} • ${formatarData(x.data)}`

            });

        }

    });


    dados.movimentacoes.forEach(x=>{

        const texto =
            `${x.origem} ${x.destino} ${x.peca} ${x.os} ${x.numeroSerie} ${x.observacao}`;

        if(texto.toLowerCase().includes(termo)){

            resultados.push({

                tipo:"🔧 Movimentação",
                titulo:`UGD ${x.origem} → UGD ${x.destino}`,
                info:`${x.peca} • OS ${x.os||"-"}`

            });

        }

    });


    dados.agenda.forEach(x=>{

        const texto =
            `${x.titulo} ${x.observacao}`;

        if(texto.toLowerCase().includes(termo)){

            resultados.push({

                tipo:"📅 Agenda",
                titulo:x.titulo,
                info:`${formatarData(x.data)} ${x.hora||""}`

            });

        }

    });


    dados.lembretes.forEach(x=>{

        const texto =
            `${x.titulo} ${x.observacao}`;

        if(texto.toLowerCase().includes(termo)){

            resultados.push({

                tipo:"🔔 Lembrete",
                titulo:x.titulo,
                info:`${formatarData(x.data)} ${x.hora||""}`

            });

        }

    });


    if(!resultados.length){

        area.innerHTML=
            `<div class="empty">
                Nenhum registro encontrado para
                "<strong>${escapar(termo)}</strong>".
            </div>`;

        return;

    }


    area.innerHTML =
        resultados.map(x=>`

        <div class="item">

            <div class="item-main">

                <div class="item-title">

                    ${x.tipo}

                </div>

                <div style="
                    color:white;
                    font-size:13px;
                    margin-top:5px;
                ">

                    ${escapar(x.titulo)}

                </div>

                <div class="item-info">

                    ${escapar(x.info)}

                </div>

            </div>

        </div>

    `).join("");

}


