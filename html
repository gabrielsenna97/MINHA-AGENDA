function abrirPagina(pagina){

    document
        .querySelectorAll(".menu-btn")
        .forEach(btn => btn.classList.remove("active"));


    const botoes =
        document.querySelectorAll(".menu-btn");

    botoes.forEach(btn => {

        if(
            btn.getAttribute("onclick") ===
            `abrirPagina('${pagina}')`
        ){

            btn.classList.add("active");

        }

    });


    document.getElementById("pageTitle").innerText =
        titulos[pagina][0];

    document.getElementById("pageSubtitle").innerText =
        titulos[pagina][1];


    const conteudo =
        document.getElementById("conteudo");


    if(pagina === "inicio")
        renderInicio();

    if(pagina === "agenda")
        renderAgenda();

    if(pagina === "tarefas")
        renderTarefas();

    if(pagina === "servicos")
        renderServicos();

    if(pagina === "movimentacoes")
        renderMovimentacoes();

    if(pagina === "programacao")
        renderProgramacao();

    if(pagina === "lembretes")
        renderLembretes();

    if(pagina === "bloco")
        renderBloco();

    if(pagina === "pesquisa")
        renderPesquisa();


    document
        .getElementById("sidebar")
        .classList.remove("open");

}


