function renderTarefasInicio(){

    const lista =
        dados.tarefas
        .filter(x => x.data === hoje())
        .slice(0,5);

    if(!lista.length)
        return `<div class="empty">Nenhuma tarefa para hoje.</div>`;


    return lista.map(x => `

        <div class="item">

            <div class="item-main">

                <div class="item-title">

                    ${escapar(x.titulo)}

                    ${x.status === "CONCLUIDA"
                        ? `<span class="badge badge-green">CONCLUÍDA</span>`
                        : `<span class="badge badge-yellow">PENDENTE</span>`
                    }

                </div>

                <div class="item-info">

                    ${x.hora || ""}
                    ${x.observacao ? " • "+escapar(x.observacao) : ""}

                </div>

            </div>

        </div>

    `).join("");

}


function renderServicosInicio(){

    const lista =
        dados.servicos
        .slice()
        .sort((a,b)=>b.id-a.id)
        .slice(0,5);

    if(!lista.length)
        return `<div class="empty">Nenhum serviço registrado.</div>`;


    return lista.map(x => `

        <div class="item">

            <div class="item-main">

                <div class="item-title">

                    UGD ${escapar(x.ugd)}

                </div>

                <div class="item-info">

                    ${escapar(x.servico)}

                    ${x.os ? " • OS "+escapar(x.os) : ""}

                </div>

            </div>

            <div class="item-info">
                ${formatarData(x.data)}
            </div>

        </div>

    `).join("");

}


function renderMovInicio(){

    const lista =
        dados.movimentacoes
        .slice()
        .sort((a,b)=>b.id-a.id)
